# GitHub API (Optional - for fetching repos)
NEXT_PUBLIC_SITE_URL=https://portfolio-5wie.vercel.app
NEXT_PUBLIC_GITHUB_USER=Ktliu-Tyler
GITHUB_TOKEN=

# Personal Publishing Agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# The publisher uses the owner session; no separate browser token is needed.
PUBLISHER_GITHUB_OWNER=
PUBLISHER_GITHUB_REPO=
PUBLISHER_GITHUB_BASE_BRANCH=main

# Private content database. Leave empty for local .private/portfolio.db.
# Vercel REQUIRES a persistent remote URL and token; never use file: there.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Set to the exact site origin in production, without a trailing slash.
ADMIN_ORIGIN=
